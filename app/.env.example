# Your running TravelTalesApp server (see server/.env.example) — localhost for web dev,
# your computer's LAN IP for native dev via Expo Go, or your deployed backend's URL.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google Cloud API key with the "Maps JavaScript API" enabled — powers the map on the web
# build only. Get one at https://console.cloud.google.com/google/maps-apis/credentials and
# restrict it to your website's domain(s). Native builds use the separate keys embedded in
# app.json instead (android.config.googleMaps.apiKey / ios.config.googleMapsApiKey), since
# native apps can't read a .env file at runtime.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase project (Project settings -> General -> Your apps -> SDK setup and configuration
# in the Firebase console) — powers accounts, friends, and messaging. Without these, the app
# works exactly as before, just without the Friends tab's sign-in/sharing features.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth 2.0 "Web client" client ID from Google Cloud console (APIs & Services -> Credentials)
# — this is auto-created when you enable Google as a Firebase Auth sign-in provider. Needed
# for Google Sign-In even on native/Android, since Firebase's Google provider verifies against
# the web client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

