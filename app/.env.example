# Your running TravelTalesApp server (see server/.env.example) — localhost for web dev,
# your computer's LAN IP for native dev via Expo Go, or your deployed backend's URL.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google Cloud API key with the "Maps JavaScript API" enabled — powers the map on the web
# build only. Get one at https://console.cloud.google.com/google/maps-apis/credentials and
# restrict it to your website's domain(s). Native builds use the separate keys embedded in
# app.json instead (android.config.googleMaps.apiKey / ios.config.googleMapsApiKey), since
# native apps can't read a .env file at runtime.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase project (Settings -> API in the Supabase dashboard) — powers accounts, friends,
# and messaging. Without these, the app works exactly as before, just without the Friends
# tab's sign-in/sharing features.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

