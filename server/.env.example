# Get a free key (no credit card) from https://console.groq.com/keys
GROQ_API_KEY=

# Model used for Story Mode generation, per-article Q&A, and Wiki mode's AI-synthesized
# search answers. "llama-3.3-70b-versatile" is Groq's flagship free-tier model. Override if
# you want a different one (e.g. "llama-3.1-8b-instant" for higher rate limits).
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3001
