# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for Story Mode generation. Must support Google Search grounding + function calling.
# "gemini-flash-latest" is a rolling alias to Google's current flash model, so it shouldn't
# need updating as specific model versions get deprecated. Override if you want a specific one.
GEMINI_MODEL=gemini-flash-latest

PORT=3001
