rules_version = '2';

// Security rules for the Friends/Messaging feature. Every other collection the app uses
// (trips, saved articles, history) lives only in on-device AsyncStorage and never touches
// Firestore, so it isn't covered here.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public-ish profile doc, written by its own owner on sign-in (see use-auth.tsx) and
    // read by anyone signed in — needed both to look someone up by email (add friend) and
    // to resolve a friend's display name/email once a friendship exists.
    match /users/{uid} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One doc per unordered pair of users, keyed by their sorted uids (see friendshipId()
    // in hooks/use-friends.ts). uidA/uidB are always stored in sorted order.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.uidA || request.auth.uid == request.resource.data.uidB) &&
        request.auth.uid == request.resource.data.requestedBy;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
    }

    // One doc per unordered pair of users, keyed the same way as friendships. `participants`
    // holds both uids so rules (and the messages subcollection below) can check membership
    // without needing the deterministic ID parsed back apart.
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
